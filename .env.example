# =====================================================================
# .env.example — salin menjadi .env dan isi nilai yang sesuai
# Jangan commit .env yang berisi secret ke repositori publik.
# =====================================================================

# Aplikasi
APP_ENV=development
APP_DEBUG=1
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=Asia/Jakarta
APP_NAME="Booking Appointment"
APP_CURRENCY=IDR

# Admin dashboard (login sederhana, sesi PHP)
ADMIN_USER=admin
# Hash password dihasilkan dengan: php -r 'echo password_hash("admin123", PASSWORD_DEFAULT);'
ADMIN_PASS_HASH=$2y$12$49OyJV0iIft9VxgJ.ZQgLOJi4IoWPcPxlXdhGw2hb9llMsSnglXKW

# Database (SQLite file, diletakkan di luar web root jika memungkinkan)
DB_DRIVER=sqlite
DB_DATABASE=/home/rawp/random/book/database/bookings.sqlite

# Google Calendar OAuth (admin / pemilik bisnis)
GOOGLE_CLIENT_ID=461342396777-vkpr27nbq9ufpn24l275anmcng0rai0i.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/booking.php
GOOGLE_CALENDAR_ID=primary
GOOGLE_ADMIN_TOKEN_FILE=/home/rawp/random/book/storage/booking-admin-token.json

# Layanan & jadwal operasional
SLOT_INTERVAL_MINUTES=30
OPENING_TIME=09:00
CLOSING_TIME=17:00
WORKING_DAYS=1,2,3,4,5,6
MIN_NOTICE_MINUTES=60
MAX_DAYS_AHEAD=60
